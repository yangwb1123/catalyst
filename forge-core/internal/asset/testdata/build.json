{
  "stage": "build",
  "phases": [
    {
      "name": "planner",
      "agent": "planner",
      "readonly": true,
      "required_gates": []
    },
    {
      "name": "implementer",
      "agent": "implementer",
      "readonly": false,
      "required_gates": []
    },
    {
      "name": "harness-gates",
      "agent": "harness",
      "readonly": true,
      "required_gates": ["lint", "test", "build", "complexity", "arch", "security"]
    },
    {
      "name": "reviewer",
      "agent": "reviewer",
      "readonly": true,
      "required_gates": [],
      "required_when": "../policies/modes.yml#workflow_depth.reviewer"
    },
    {
      "name": "qa",
      "agent": "qa",
      "readonly": true,
      "required_gates": ["test"]
    }
  ],
  "stop_condition": {
    "type": "conjunction",
    "all_of": [
      {"metric": "roadmap_completion", "operator": "==", "threshold": 100},
      {"metric": "gates_status", "operator": "==", "value": "green"}
    ],
    "anti_pattern": "round_count"
  }
}
