{
  "stage": "build",
  "phases": [
    {
      "name": "planner",
      "agent": "planner",
      "readonly": true,
      "required_gates": []
    },
    {
      "name": "implementer",
      "agent": "implementer",
      "readonly": false,
      "required_gates": []
    },
    {
      "name": "harness-gates",
      "agent": "harness",
      "readonly": true,
      "required_gates": ["lint", "test", "build", "complexity", "arch", "security"],
      "on_fail": {"action": "loop_back", "target_phase": "implementer"}
    },
    {
      "name": "reviewer",
      "agent": "reviewer",
      "readonly": true,
      "required_gates": [],
      "required_when": "../policies/modes.yml#workflow_depth.reviewer",
      "on_fail": {"action": "loop_back", "target_phase": "implementer"}
    },
    {
      "name": "qa",
      "agent": "qa",
      "verdict_contract": "qa_v1",
      "readonly": true,
      "required_gates": ["test"],
      "on_fail": {"action": "loop_back", "target_phase": "implementer"}
    }
  ],
  "stop_condition": {
    "type": "conjunction",
    "all_of": [
      {"metric": "roadmap_completion", "operator": "==", "threshold": 100},
      {"metric": "gates_status", "operator": "==", "value": "green"}
    ],
    "anti_pattern": "round_count",
    "on_unmet": {"action": "loop_to_next_roadmap_item", "target_phase": "planner"}
  }
}
