    "head_set_domain": "forgeos.authenticated-architecture-decision-lifecycle.head-set.v1\u0000",
    "view_domain": "forgeos.authenticated-architecture-decision-lifecycle.materialized-view.v1\u0000",
    "state_domain": "forgeos.authenticated-architecture-decision-lifecycle.state.v1\u0000",
    "record_key_domain": "forgeos.authenticated-architecture-decision-lifecycle.idempotency-record-key.v1\u0000",
    "self_digest_rules": [
      "each self-digest field is empty in its own preimage",
      "request_id and request_sha256 are jointly empty",
      "acceptance_id and acceptance_sha256 are jointly empty",
      "supersession receipt_id and receipt_sha256 are jointly empty",
      "signature.signature_base64url is empty for every signed-shaped lifecycle artifact",
      "authorization_receipt_physical_sha256 is bare SHA-256 of exact canonical embedded ADR-0081 receipt bytes including signature bytes"
    ]
  },
  "x-forgeos-signature-domains": {
    "message_suffix": "raw_32_byte_artifact_sha256_digest",
    "request": "forgeos.authenticated-architecture-decision-lifecycle.request.signature.v1\u0000",
    "acceptance_receipt": "forgeos.authenticated-architecture-decision-lifecycle.acceptance-receipt.signature.v1\u0000",
