    "prerequisite_domain": "forgeos.authenticated-architecture-decision-lifecycle.acceptance-prerequisite.v1\u0000",
    "request_domain": "forgeos.authenticated-architecture-decision-lifecycle.request.v1\u0000",
    "acceptance_domain": "forgeos.authenticated-architecture-decision-lifecycle.acceptance-receipt.v1\u0000",
