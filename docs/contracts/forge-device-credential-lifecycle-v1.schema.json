{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/contracts/forge-device-credential-lifecycle-v1.schema.json",
  "title": "Forge device credential lifecycle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_mode", "notice", "authority", "cases"],
  "properties": {
    "schema_version": {"const": "forge.device-credential-lifecycle/v1"},
    "evaluation_mode": {"const": "pure_device_credential_lifecycle"},
    "notice": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_authenticated", "credential_material_made", "persisted", "inventory_authoritative", "execution_authorized"],
      "properties": {
        "owner_authenticated": {"const": false},
        "credential_material_made": {"const": false},
        "persisted": {"const": false},
        "inventory_authoritative": {"const": false},
        "execution_authorized": {"const": false}
      }
    },
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
