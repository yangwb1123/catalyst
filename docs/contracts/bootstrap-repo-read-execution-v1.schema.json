        "idempotency_key": { "$ref": "#/$defs/idempotency" }, "invocation_id": { "type": "string", "pattern": "^bootstrap-repo-read-invocation-[0-9a-f]{64}(?![\\s\\S])" }, "invocation_sha256": { "$ref": "#/$defs/hash" }, "issuance_trust_epoch": { "$ref": "#/$defs/epoch" }, "issuance_trust_root_sha256": { "$ref": "#/$defs/hash" }, "kind": { "const": "BootstrapRepoReadInvocation" }, "manifest_sha256": { "$ref": "#/$defs/hash" }, "profile_id": { "$ref": "#/$defs/profile_id" }, "requested_action": { "$ref": "#/$defs/requested_action" }, "requested_action_sha256": { "$ref": "#/$defs/hash" }, "requested_at_unix_ms": { "$ref": "#/$defs/unix_ms" }, "signature": { "$ref": "#/$defs/signature" }, "subject": { "$ref": "#/$defs/principal" }, "task_binding": { "$ref": "#/$defs/task_binding" }
      }
    },
    "reason": { "oneOf": [{ "enum": ["content_mismatch", "cooperative_timeout_exceeded", "effect_outcome_uncertain", "orphaned_effect_intent", "orphaned_reserved_no_repo_io", "repository_identity_changed", "repository_read_failed"] }, { "type": "null" }] },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["api_version", "canonicalization", "effect_intent_receipt_sha256", "execution_policy_sha256", "execution_result_sha256", "execution_trust_epoch", "execution_trust_root_sha256", "grant_envelope_sha256", "grant_id", "grant_issuance_receipt_sha256", "grant_sha256", "idempotency_record_key_sha256", "invocation_id", "invocation_sha256", "issuance_trust_epoch", "issuance_trust_root_sha256", "kind", "ledger_sequence", "manifest_sha256", "prior_usage_receipt_sha256", "profile_id", "reason_code", "receipt_sha256", "recorded_at_unix_ms", "requested_action_sha256", "reservation_receipt_sha256", "result_metadata_sha256", "signature", "state"],
