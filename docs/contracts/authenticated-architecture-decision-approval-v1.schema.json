  "additionalProperties": false,
  "required": ["authorization_ledger", "authorization_policy", "authorization_receipt", "authorization_request", "authorization_result", "proposal_binding", "proposal_document_base64url", "revocation_snapshot", "signature_profile", "trust_root"],
