{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/contracts/authenticated-architecture-decision-approval-v1.schema.json",
  "title": "Authenticated Architecture Decision Approval v1 prerequisite structural candidate",
